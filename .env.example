# Environment variables read by pokerlandapi/settings.py.
#
# Local development:   cp .env.example .env
# Deployed stages:     cp .env.example .env.dev   (or .env.prod)
#   scripts/deploy.py uploads .env.<stage> to the stage's remote_env S3 file,
#   which Zappa loads into the Lambda environment at cold start. In those files
#   delete DJANGO_ENV (zappa_settings.json sets it) and give every other
#   variable below a value.
#
# Never commit .env, .env.dev or .env.prod.

# local | dev | prod. DEBUG is on only for local.
DJANGO_ENV=local

# Generate one per environment:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames.
#   dev:  .execute-api.ap-northeast-2.amazonaws.com
#   prod: the custom domain, e.g. api.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API with credentials.
#   local: the Vite dev server (pokerland-client `npm run dev`)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL. Leave DB_NAME empty locally to use db.sqlite3; required for dev and prod.
# For the local container in compose.yaml (`docker compose up -d`), set:
#   DB_NAME=pokerland
#   DB_USER=pokerland
#   DB_PASSWORD=pokerland
#   DB_HOST=127.0.0.1
# An empty DB_HOST connects through a Unix socket, which the container doesn't have.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Tracker uploads. Trackers older than this version get 426 and must update.
# Locally, 0.0.0 also admits tracker builds made without a version (0.0.0-dev).
TRACKER_MIN_CLIENT_VERSION=0.1.0

# Private S3 bucket for the raw gzipped hand-history chunks. Leave empty locally
# to write them under var/raw/ instead; required for dev and prod.
TRACKER_RAW_BUCKET=
